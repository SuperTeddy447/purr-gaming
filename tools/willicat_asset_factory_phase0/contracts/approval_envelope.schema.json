{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:willicat:phase0:approval_envelope:1",
  "type": "object",
  "properties": {
    "payload": {
      "$ref": "approval_payload.schema.json"
    },
    "signed_payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "algorithm": {
      "const": "RSA-PSS-SHA256-MGF1SHA256-SALT32"
    }
  },
  "required": [
    "payload",
    "signed_payload_hash",
    "signature",
    "algorithm"
  ],
  "additionalProperties": false
}
