{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:willicat:phase0:review_record:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "gate": {
      "enum": [
        "rights",
        "structural",
        "motion",
        "visual",
        "runtime",
        "human"
      ]
    },
    "owner_role": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "asset_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "result": {
      "enum": [
        "passed",
        "failed",
        "pending",
        "not_applicable"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "evidence_id",
          "sha256",
          "artifact_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "criteria_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "enum": [
              "foliage_led_sway",
              "no_whole_sprite_scale_pulse",
              "readable_authored_arc",
              "seam_perceptually_continuous"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        },
        "required": [
          "criterion_id",
          "result"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "gate",
    "owner_role",
    "timestamp",
    "asset_id",
    "asset_version",
    "attempt_id",
    "result",
    "evidence",
    "notes"
  ],
  "additionalProperties": false
}
